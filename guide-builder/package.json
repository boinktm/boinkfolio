{
  "name": "boinkfolio-content-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop app for managing Boinkfolio content collections and interactive guides",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5199 --strictPort\" \"wait-on http://127.0.0.1:5199 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5199&& electron .\"",
    "build": "vite build",
    "build:exe": "vite build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.boinkbrands.content-manager",
    "productName": "Boinkfolio Content Manager",
    "directories": {
      "output": "../desktop-app/electron-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.2.1",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
