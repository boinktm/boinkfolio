---
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="chrome-divider"></div>

  <div class="max-w-[var(--width-content)] mx-auto px-4 py-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Brand / Home link -->
      <a href={withBase()} class="flex items-center gap-2 group">
        <div class="w-6 h-6 rounded-full bg-accent flex items-center justify-center text-white text-[8px] font-display font-bold
                    group-hover:shadow-[0_0_12px_rgba(230,0,18,0.5)] transition-shadow">
          BB
        </div>
        <span class="font-display text-sm uppercase tracking-wider text-text-secondary group-hover:text-text-primary transition-colors">
          Boink Brands
        </span>
      </a>

      <!-- Copyright -->
      <p class="text-[10px] text-text-muted">
        &copy; {year} Boink Brands. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>
