  <!-- ── Scripts ── -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline>
    const initBO3Guide = () => {
      // ── IntersectionObserver for sidebar nav ──
      const navLinks = Array.from(document.querySelectorAll('.bo3-nav-link'));
      const sections = Array.from(document.querySelectorAll('[data-guide-section]'));

      if (navLinks.length && sections.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              navLinks.forEach((link) => {
                const isMatch = link.getAttribute('href') === `#${entry.target.id}`;
                link.classList.toggle('is-active', isMatch);
              });
            });
          },
          {
            root: null,
            rootMargin: '-18% 0px -65% 0px',
            threshold: 0,
          }
        );
        sections.forEach((section) => observer.observe(section));
      }

      // ── Accordion logic ──
      const accordionButtons = Array.from(document.querySelectorAll('[data-accordion-btn]'));
      accordionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const panel = button.nextElementSibling;
          const icon = button.querySelector('.accordion-icon');
          const isOpen = panel?.style.maxHeight;

          accordionButtons.forEach((otherButton) => {
            const otherPanel = otherButton.nextElementSibling;
            const otherIcon = otherButton.querySelector('.accordion-icon');
            if (otherPanel) otherPanel.style.maxHeight = null;
            if (otherIcon) otherIcon.textContent = '+';
            otherButton.classList.remove('is-open');
          });

          if (panel && !isOpen) {
            panel.style.maxHeight = `${panel.scrollHeight}px`;
            button.classList.add('is-open');
            if (icon) icon.textContent = '-';
          }
        });
      });

      // ── Tab logic ──
      const tabButtons = Array.from(document.querySelectorAll('[data-tab-btn]'));
      const tabPanels = Array.from(document.querySelectorAll('.tab-panel'));
      tabButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-target');
          if (!targetId) return;
          tabButtons.forEach((b) => b.classList.remove('is-active'));
          button.classList.add('is-active');
          tabPanels.forEach((panel) => {
            panel.classList.toggle('hidden', panel.id !== targetId);
          });
        });
      });

      // ── Chart.js radar chart ──
      const ecoCanvas = document.getElementById('ecosystemChart');
      if (ecoCanvas && window.Chart) {
        new window.Chart(ecoCanvas, {
          type: 'radar',
          data: {
            labels: ['Real-time Help', 'Syntax Tutorials', 'Code Accuracy', 'Asset Sharing', 'Tool Updates'],
            datasets: [
              {
                label: 'Discord Servers',
                data: [95, 40, 80, 75, 85],
                backgroundColor: 'rgba(230, 0, 18, 0.18)',
                borderColor: '#e60012',
                pointBackgroundColor: '#ff1a2e',
                borderWidth: 2,
              },
              {
                label: 'YouTube',
                data: [10, 95, 60, 30, 40],
                backgroundColor: 'rgba(85, 85, 85, 0.18)',
                borderColor: '#888888',
                pointBackgroundColor: '#aaaaaa',
                borderWidth: 2,
              },
              {
                label: 'Archived Wikis',
                data: [0, 85, 95, 20, 10],
                backgroundColor: 'rgba(136, 136, 136, 0.12)',
                borderColor: '#555555',
                pointBackgroundColor: '#666666',
                borderWidth: 2,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              r: {
                angleLines: { color: 'rgba(85, 85, 85, 0.4)' },
                grid: { color: 'rgba(85, 85, 85, 0.4)' },
                pointLabels: { color: '#aaaaaa', font: { size: 11, weight: 'bold' } },
                ticks: { display: false, max: 100, min: 0 },
              },
            },
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: '#aaaaaa', usePointStyle: true, padding: 20 },
              },
              tooltip: {
                backgroundColor: '#161616',
                titleColor: '#e60012',
                bodyColor: '#f0f0f0',
                borderColor: '#2d2d2d',
                borderWidth: 1,
              },
            },
          },
        });
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBO3Guide, { once: true });
    } else {
      initBO3Guide();
    }
  </script>
</Layout>

