---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SubNav from '../../components/SubNav.astro';
import Footer from '../../components/Footer.astro';
import BoinkdexApp from '../../components/boinkdex/BoinkdexApp.jsx';
---

<Layout title="Boinkdex Tracker - Boink Brands" description="Interactive multi-region Boinkdex tracker with capture progress, save import/export, and QR sync.">
  <Header />
  <SubNav activeTab="3D Art" />

  <section class="bg-obsidian py-8 md:py-10">
    <div class="max-w-[var(--width-content)] mx-auto px-4">
      <BoinkdexApp client:only="react" />
    </div>
  </section>

  <Footer />
</Layout>
