---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SubNav from '../../components/SubNav.astro';
import Footer from '../../components/Footer.astro';
import { withBase } from '../../lib/paths';

const GRADIENT_GRAY = 'rgba(255,255,255,0.08)_0%,rgba(20,20,20,0.92)_62%';
const GRADIENT_RED = 'rgba(230,0,18,0.14)_0%,rgba(20,20,20,0.9)_60%';
const GRADIENT_GOLD = 'rgba(250,204,21,0.14)_0%,rgba(20,20,20,0.92)_62%';

const guides = [
  {
    slug: 'pokemon-gba-rom-hacking-guide',
    title: 'Pokemon GBA ROM Hacking',
    description: 'Beginner to intermediate guide covering the modern decompilation workflow, GBA hardware architecture, Porymap, Poryscript, and a structured four-week learning curriculum.',
    date: '2026-03-15',
    dateLabel: 'Mar 2026',
    featured: true,
  },
  {
    slug: 'bo3-gsc-guide',
    title: 'Black Ops 3 Mod Tools GSC',
    description: 'The definitive 2026 deep dive into GSC architecture, WaW migration, syntax reference, learning roadmap, ecosystem analysis, and toolchain evolution.',
    date: '2026-02-15',
    dateLabel: 'Feb 2026',
    featured: false,
  },
  {
    slug: 'pokemon-diamond-pearl-vs-platinum',
    title: 'Pokemon Diamond, Pearl, and Platinum',
    description: 'Explore the Sinnoh comparison dashboard covering engine cleanup, progression changes, regional dex growth, and regional cartridge revisions.',
    date: '2026-01-20',
    dateLabel: 'Jan 2026',
    featured: false,
  },
  {
    slug: 'botw-60fps-guide',
    title: 'Breath of the Wild: 60 FPS Optimization',
    description: 'Open the full step-by-step dashboard with checklist tracking, plugin installation order, overclock target charts, and realistic performance expectations.',
    date: '2026-01-10',
    dateLabel: 'Jan 2026',
    featured: false,
  },
].sort((a, b) => b.date.localeCompare(a.date));

const assets = [
  {
    slug: 'boinkdex',
    title: 'Boinkdex Tracker',
    description: 'Open the multi-region Boinkdex with capture tracking, shiny mode, save/import code, and QR sync backup.',
    date: '2026-02-01',
    dateLabel: 'Feb 2026',
    featured: true,
  },
].sort((a, b) => b.date.localeCompare(a.date));

const guideGradient = (g: typeof guides[number]) => g.featured ? GRADIENT_RED : GRADIENT_GRAY;
const assetGradient = (a: typeof assets[number]) => a.featured ? GRADIENT_GOLD : GRADIENT_GRAY;
---

<Layout title="Assets and Guides — Boink Brands" description="Browse interactive guides and standalone assets from Boink Brands.">
  <Header />
  <SubNav activeTab="3D Art" />

  <section class="bg-void relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(230,0,18,0.07)_0%,transparent_70%)]"></div>
    <div class="relative max-w-[var(--width-content)] mx-auto px-4 py-16 md:py-20 text-center">
      <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-accent mb-3">Library</p>
      <h1 class="font-display text-4xl md:text-6xl uppercase leading-none tracking-tight mb-4">
        <span class="text-gradient">Assets</span>
        <br />
        <span class="text-text-primary">and Guides</span>
      </h1>
      <p class="text-text-secondary text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
        Switch between deep editorial guides and standalone assets. Guides are structured walkthroughs and analyses.
        Assets are practical tools or resources you can use directly.
      </p>
    </div>
    <div class="chrome-divider"></div>
  </section>

  <section class="bg-obsidian py-8">
    <div class="max-w-[var(--width-content)] mx-auto px-4 space-y-4">
      <div class="surface-card rounded-sm p-3 md:p-4">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <p class="text-[10px] uppercase tracking-widest text-text-muted font-bold">Browse By Type</p>
          <div class="inline-flex w-full md:w-auto bg-charcoal/50 border border-border rounded-sm p-1">
            <button type="button" class="content-toggle-btn is-active" data-content-toggle-btn data-target="guides-panel" aria-pressed="true">Guides</button>
            <button type="button" class="content-toggle-btn" data-content-toggle-btn data-target="assets-panel" aria-pressed="false">Assets</button>
          </div>
        </div>
      </div>

      <div id="guides-panel" data-content-panel class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {guides.map(guide => (
            <a href={withBase(`assets-and-guides/${guide.slug}`)} class:list={["surface-card rounded-sm overflow-hidden block group", guide.featured && "border-glow"]}>
              <div class={`relative h-full p-6 md:p-8 bg-[linear-gradient(135deg,${guideGradient(guide)})]`}>
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <p class="text-[9px] font-bold uppercase tracking-widest text-accent">Interactive Guide</p>
                  <span class="text-[9px] font-bold uppercase tracking-wider text-text-muted">{guide.dateLabel}</span>
                </div>
                <h2 class="font-display text-2xl md:text-4xl uppercase text-text-primary leading-none mb-3">{guide.title}</h2>
                <p class="text-sm text-text-secondary max-w-2xl">{guide.description}</p>
                <p class="text-[10px] uppercase tracking-wider text-text-muted mt-4">Open Guide -></p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div id="assets-panel" data-content-panel class="hidden space-y-4">
        {assets.map(asset => (
          <a href={withBase(`assets-and-guides/${asset.slug}`)} class:list={["surface-card rounded-sm overflow-hidden block group", asset.featured && "border-glow"]}>
            <div class={`relative h-full p-6 md:p-8 bg-[linear-gradient(135deg,${assetGradient(asset)})]`}>
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <p class="text-[9px] font-bold uppercase tracking-widest text-accent">Interactive Asset</p>
                <span class="text-[9px] font-bold uppercase tracking-wider text-text-muted">{asset.dateLabel}</span>
              </div>
              <h2 class="font-display text-2xl md:text-4xl uppercase text-text-primary leading-none mb-3">{asset.title}</h2>
              <p class="text-sm text-text-secondary max-w-2xl">{asset.description}</p>
              <p class="text-[10px] uppercase tracking-wider text-text-muted mt-4">Open Asset -></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    const initAssetsGuidesToggle = () => {
      const buttons = Array.from(document.querySelectorAll('[data-content-toggle-btn]'));
      const panels = Array.from(document.querySelectorAll('[data-content-panel]'));

      if (!buttons.length || !panels.length) return;

      const setActivePanel = (targetId) => {
        buttons.forEach((button) => {
          const isActive = button.getAttribute('data-target') === targetId;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.id !== targetId);
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-target');
          if (!targetId) return;
          setActivePanel(targetId);
        });
      });

      setActivePanel('guides-panel');
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAssetsGuidesToggle, { once: true });
    } else {
      initAssetsGuidesToggle();
    }
  </script>

  <Footer />
</Layout>

<style>
  .content-toggle-btn {
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
    flex: 1;
  }

  .content-toggle-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-light);
    background: rgba(255, 255, 255, 0.03);
  }

  .content-toggle-btn.is-active {
    color: #ffffff;
    border-color: var(--color-accent);
    background: rgba(230, 0, 18, 0.15);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }
</style>
