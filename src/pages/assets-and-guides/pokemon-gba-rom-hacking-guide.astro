  <script is:inline>
    const initRomHackingGuide = () => {
      const navLinks = Array.from(document.querySelectorAll('.guide-nav-link'));
      const sections = Array.from(document.querySelectorAll('[data-guide-section]'));

      if (navLinks.length && sections.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              navLinks.forEach((link) => {
                const isMatch = link.getAttribute('href') === `#${entry.target.id}`;
                link.classList.toggle('is-active', isMatch);
              });
            });
          },
          {
            root: null,
            rootMargin: '-18% 0px -65% 0px',
            threshold: 0,
          }
        );

        sections.forEach((section) => observer.observe(section));
      }

      const accordionButtons = Array.from(document.querySelectorAll('[data-accordion-btn]'));
      accordionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const panel = button.nextElementSibling;
          const icon = button.querySelector('.accordion-icon');
          const isOpen = panel?.style.maxHeight;

          if (panel && !isOpen) {
            panel.style.maxHeight = `${panel.scrollHeight}px`;
            button.classList.add('is-open');
            if (icon) icon.textContent = '-';
          } else if (panel) {
            panel.style.maxHeight = null;
            button.classList.remove('is-open');
            if (icon) icon.textContent = '+';
          }
        });
      });

      const checklistItems = Array.from(document.querySelectorAll('[data-checklist-item]'));
      checklistItems.forEach((item) => {
        item.addEventListener('click', () => {
          item.classList.toggle('checked');
          const marker = item.querySelector('.checkmark');
          if (!marker) return;
          marker.textContent = item.classList.contains('checked') ? '[x]' : '[ ]';
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRomHackingGuide, { once: true });
    } else {
      initRomHackingGuide();
    }
  </script>
